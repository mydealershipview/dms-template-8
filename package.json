{
  "name": "mydv-template-8-light-dms",
  "version": "2.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "dev:prod": "npm run build && npm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "npm run test:int",
    "test:e2e": "playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "type-check": "tsc --noEmit",
    "provision:admin": "payload run scripts/create-admin.ts",
    "test:isolated": "node scripts/run-isolated.mjs npm run test:int",
    "verify:production": "node scripts/verify-production.mjs",
    "test:production": "node scripts/run-isolated.mjs --services npm run verify:production"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "3.4.2",
    "@next/third-parties": "16.4.3",
