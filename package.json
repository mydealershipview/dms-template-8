    "lucide-react": "0.378.0",
    "motion": "12.38.0",
    "next": "16.4.3",
    "next-sitemap": "4.2.3",
    "payload": "3.93.0",
    "postcss": "8.5.31",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
