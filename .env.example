# One dealership per deployment. Set real secrets privately; never copy another site's .env.
DATABASE_URI=mongodb://127.0.0.1:27017/template2-local
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=https://dealer.example
NEXT_PUBLIC_SITE_URL=https://dealer.example
SITE_CANONICAL_HOST=dealer.example
SITE_REDIRECT_HOSTS=www.dealer.example
SITE_NOINDEX=true   # SEO_NOINDEX=true is equivalent
# DMS origin and per-dealer website key. No direct AutoTrader credentials on websites.
DMS_URL=https://app.mydealershipview.com
DMS_WEBSITE_KEY=
DMS_ADVERTISER_ID=
STOCK_MAX_STALE_HOURS=12
# Lead dealer UUID is distinct from the AutoTrader advertiser ID.
DEALER_ID=
FORM_SUBMIT_WEBHOOK_URL=https://app.mydealershipview.com/api/webhooks/external-notifications
EXTERNAL_NOTIFICATIONS_WEBHOOK_SECRET=
LEAD_SOURCE_WEBSITE=dealer.example
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Only enable behind a proxy that replaces forwarding headers.
# Demo deployments only (requires SEO_NOINDEX=true): skip Turnstile. Never on a live client site.
# TURNSTILE_DEMO_BYPASS=true
FORMS_TRUST_PROXY=false
CRON_SECRET=
GLITCHTIP_DSN=
NEXT_PUBLIC_GLITCHTIP_DSN=
# Permanent owned media. Required for deployed sold-photo archives.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional durable local volume path for non-serverless hosts (otherwise use S3).
MEDIA_LOCAL_DIR=
DMS_IMAGE_ORIGINS=
SOLD_PHOTO_LIMIT=10
SOLD_PENDING_RETENTION_DAYS=7
CSP_SCRIPT_SOURCES=
CSP_CONNECT_SOURCES=
CSP_FRAME_SOURCES=
# Public identity only, independent of lead routing. Existing CMS settings take precedence.
DEALER_PROFILE=template
DEALER_NAME=
DEALER_PUBLIC_EMAIL=
# Temporary human-only initial CMS provisioning. Remove immediately after use.
# PROVISION_ADMIN_EMAIL=
# PROVISION_ADMIN_PASSWORD=
